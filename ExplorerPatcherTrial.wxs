<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://microsoft.com">
  <Product Id="*" 
           Name="ExplorerPatcher" 
           Language="1042" 
           Version="1.0.0" 
           Manufacturer="ExplorerPatcher Team" 
           UpgradeCode="12345678-1234-1234-1234-123456789ABC">
    
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="이미 더 새로운 버전이 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" />

    <!-- 표준 32비트/64비트 공용 폴더 트리 구성 -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="ExplorerPatcher" />
      </Directory>
    </Directory>

    <!-- 외부 실제 파일 없이 텍스트 내용으로 직접 생성되는 컴포넌트 -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainConfig" Guid="87654321-4321-4321-4321-CBA987654321">
        <!-- 외부 원본 소스 파일 추적을 피하기 위해 인라인 파일 생성 방식을 씁니다. -->
        <File Id="ConfigNote" Name="Readme.txt" Source="$(sys.SOURCEFILEPATH)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="ExplorerPatcher Installation" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Product>
</Wix>
